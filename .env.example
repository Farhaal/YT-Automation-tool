# Optional: copy this file to ".env" to change defaults. Never commit your real .env.
# OpenReel works without a .env file at all.
#
# API keys (Pexels, Pixabay, AI providers) are easiest to set in the app's
# Settings page. Pexels/Pixabay keys may also be provided here.

# ---- Free stock-media keys (optional) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Speech-to-text ----
# Model size: tiny | base | small | medium | large-v3  (bigger = more accurate, slower)
WHISPER_MODEL=small
# auto = use NVIDIA GPU if available, otherwise CPU. Or force: cuda | cpu
DEVICE=auto

# ---- Voiceover for the "type a script" flow ----
TTS_ENGINE=pyttsx3

# ---- Local AI (only if you run Ollama) ----
OLLAMA_URL=http://localhost:11434

# ---- Where models, downloads, jobs, renders and settings are stored ----
OPENREEL_DATA_DIR=./data
HF_HOME=./data/cache/huggingface
TORCH_HOME=./data/cache/torch
