# Copy this file to ".env" and fill in your keys. Never commit the real .env.

# ---- Free stock-media API keys (both free to create) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Openverse & Wikimedia Commons need no key (rate-limited).

# ---- Optional extras ----
UNSPLASH_ACCESS_KEY=
LLM_PROVIDER=                   # openai | openrouter | groq | ollama
LLM_API_KEY=
LLM_MODEL=                      # e.g. gpt-4o-mini
LLM_BASE_URL=                   # custom OpenAI-compatible endpoint

# ---- Runtime ----
# WHISPER_MODEL options: tiny, base, small, medium, large-v3.
# "small" is the default for speed. Use "medium" or "large-v3" for higher accuracy.
WHISPER_MODEL=small
DEVICE=auto                     # auto | cuda | cpu
TTS_ENGINE=pyttsx3              # pyttsx3 | piper | kokoro | xtts(non-commercial)
OLLAMA_URL=http://localhost:11434   # optional local LLM for smarter search queries

# ---- Keep all downloads inside the project folder (containment) ----
# These point model/cache downloads at ./ (the repo) instead of your home drive.
OPENREEL_DATA_DIR=./data          # models, caches, downloads, renders live here
HF_HOME=./data/cache/huggingface
TORCH_HOME=./data/cache/torch
