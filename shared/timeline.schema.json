{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenReel Timeline",
  "type": "object",
  "required": ["version", "resolution", "audio", "scenes", "captions"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer"
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "number" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["path", "duration"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "text": { "type": "string" },
          "asset": {
            "$ref": "#/definitions/AssetMetadata"
          },
          "backup_asset": {
            "$ref": "#/definitions/AssetMetadata"
          },
          "motion": { "type": "string" },
          "transition_out": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "duration": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "word": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 }
        }
      }
    },
    "popups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0 },
          "type": { "type": "string" },
          "path": { "type": "string" },
          "position": { "type": "string" },
          "animation": { "type": "string" }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "gain_db": { "type": "number" },
        "duck_under_voice": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "AssetMetadata": {
      "type": ["object", "null"],
      "required": ["type", "path", "source", "author", "license", "url", "asset_key", "provider_asset_id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["video", "image"] },
        "path": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "url": { "type": "string" },
        "asset_key": { "type": "string" },
        "provider_asset_id": { "type": "string" },
        "license_url": { "type": ["string", "null"] },
        "attribution_required": { "type": "boolean" },
        "attribution_text": { "type": ["string", "null"] }
      }
    }
  }
}
