{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenReel Timeline",
  "type": "object",
  "required": ["version", "resolution", "audio", "scenes", "captions"],
  "properties": {
    "version": {
      "type": "integer"
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "number" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["path", "duration"],
      "properties": {
        "path": { "type": "string" },
        "duration": { "type": "number" }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "text", "asset"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "text": { "type": "string" },
          "asset": {
            "type": ["object", "null"],
            "required": ["type", "path", "source", "author", "license", "url"],
            "properties": {
              "type": { "type": "string", "enum": ["video", "image"] },
              "path": { "type": "string" },
              "source": { "type": "string" },
              "author": { "type": "string" },
              "license": { "type": "string" },
              "url": { "type": "string" }
            }
          },
          "motion": { "type": "string" },
          "transition_out": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "duration": { "type": "number" }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "start", "end"],
        "properties": {
          "word": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" }
        }
      }
    },
    "popups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "number" },
          "duration": { "type": "number" },
          "type": { "type": "string" },
          "path": { "type": "string" },
          "position": { "type": "string" },
          "animation": { "type": "string" }
        }
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "gain_db": { "type": "number" },
        "duck_under_voice": { "type": "boolean" }
      }
    }
  }
}
